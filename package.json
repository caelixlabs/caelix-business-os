{
  "name": "caelix-business-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "biome check --write .",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} + && find . -name .next -type d -prune -exec rm -rf {} + && find . -name dist -type d -prune -exec rm -rf {} +",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@changesets/cli": "^2.31.1",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "prisma": "6.16.3",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/client": "6.16.3",
    "pnpm": "^10.34.5"
  }
}
