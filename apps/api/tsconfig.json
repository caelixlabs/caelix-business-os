{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    },
    "declaration": true,
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "incremental": true,
    "types": ["jest", "node", "multer"]
  },
  "include": ["src/**/*", "src/**/*.spec.ts", "src/**/*.test.ts", "test/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}