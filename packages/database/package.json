{
  "name": "@caelix-business-os/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsc -p tsconfig.json && node scripts/sync-generated.mjs",
    "dev": "node scripts/sync-generated.mjs && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "sync:generated": "node scripts/sync-generated.mjs",
    "generate": "dotenv -e ../../.env -- prisma generate --schema prisma/schema.prisma && node scripts/sync-generated.mjs",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prisma": "^6.16.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
