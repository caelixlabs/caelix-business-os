{
  "name": "@caelix-business-os/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json && npm run sync:generated",
    "dev": "npm run sync:generated && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "studio": "prisma studio --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prisma": "^6.16.3",
    "typescript": "^5.7.0"
  }
}