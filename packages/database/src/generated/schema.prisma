// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IndustryType {
  MUSIC_ORG
  GYM
  SALON
}

model Organization {
  id String @id @db.Char(32)

  name        String
  slug        String  @unique
  description String?

  industry      IndustryType
  branches      Branch[]
  users         User[]
  roles         Role[]
  auditLogs     AuditLog[]
  settings      OrganizationSetting[]
  notifications Notification[]

  // Music Org - current feature set
  musicStudents     MusicStudent[]
  musicCourses      MusicCourse[]
  musicBatches      MusicBatch[]
  musicEnrollments  MusicEnrollment[]
  musicPracticeLogs MusicPracticeLog[]

  // Gym
  gymMembers GymMember[]
  gymClasses GymClass[]

  attendances Attendance[]

  membershipPlans         MembershipPlan[]
  membershipSubscriptions MembershipSubscription[]
  sales                   Sale[]

  contacts  Contact[]
  products  Product[]
  inventory InventoryItem[]
  enquiries Enquiry[]
  bookings  Booking[]
  invoices  Invoice[]
  payments  Payment[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BranchType {
  PRIMARY
  STANDARD
}

model Branch {
  id             String @id @db.Char(32)
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  code        String
  type        BranchType   @default(STANDARD)
  description String?
  status      BranchStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  contacts Contact[]

  // New Music Org
  musicStudents MusicStudent[]
  musicBatches  MusicBatch[]

  // Gym
  gymMembers GymMember[]
  gymClasses GymClass[]

  //inventory
  inventory InventoryItem[]
  enquiries Enquiry[]
  bookings  Booking[]
  invoices  Invoice[]
  documents Document[]
  sales     Sale[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
}

model DomainEvent {
  id            String    @id @db.Char(32)
  aggregateId   String
  aggregateType String
  eventName     String
  payload       Json
  occurredAt    DateTime
  publishedAt   DateTime?

  @@index([aggregateId])
  @@index([publishedAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

model User {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  email        String
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  userRoles     UserRole[]
  notifications Notification[]

  // New Music Org batches
  musicTeachingBatches MusicBatch[]
  enquiries            Enquiry[]
  uploadedDocuments    Document[]
  gymClassesTraining   GymClass[]
  salesSold            Sale[]
  saleLinesStaffed     SaleLine[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, branchId])
}

model RefreshToken {
  id     String @id @db.Char(32)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// Fixed hierarchy: OWNER > ADMIN > MANAGER > EMPLOYEE > VIEWER.
enum RoleLevel {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

model Role {
  id             String        @id @db.Char(32)
  organizationId String? // null = system-defined role template, seeded once and reused by every org
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  level    RoleLevel
  isSystem Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String @id @db.Char(32)
  code        String @unique // e.g. "organization:update", "branch:create"
  description String
  module      String // e.g. "organization", "branch", "users"

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  branchId String? // null = organization-wide grant

  @@id([userId, roleId])
  @@index([userId])
}

model AuditLog {
  id             String       @id @db.Char(32)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId    String?
  actorUserId String? // null = system-initiated action (e.g. auto-created primary branch)

  action     String // e.g. "organization.created", "branch.created", "user.registered"
  entityType String // e.g. "Organization", "Branch", "User"
  entityId   String

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([organizationId, entityType])
  @@index([entityType, entityId])
}

model OrganizationSetting {
  id             String       @id @db.Char(32)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key   String
  value Json

  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Notification {
  id             String       @id @db.Char(32)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String // recipient
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // e.g. "user.registered", "branch.created", "role.changed"
  title    String
  message  String
  metadata Json?
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([organizationId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  STRIPE
  CASH
  BANK_TRANSFER
  UPI
  POS
}

enum MusicStudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  ON_HOLD
}

enum MusicSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum MusicCourseStatus {
  ACTIVE
  INACTIVE
}

enum MusicBatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MusicEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model MusicStudent {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Name/email/phone live on the generic Contact — MusicStudent only
  // carries the fields that are actually music-academy-specific.
  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  studentNo String

  dateOfBirth DateTime?

  guardianName  String?
  guardianPhone String?
  guardianEmail String?

  instrument String?
  skillLevel MusicSkillLevel    @default(BEGINNER)
  status     MusicStudentStatus @default(ACTIVE)

  joinedAt DateTime @default(now())
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments  MusicEnrollment[]
  practiceLogs MusicPracticeLog[]

  @@unique([organizationId, studentNo])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
}

model MusicCourse {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?

  instrument String?
  skillLevel MusicSkillLevel @default(BEGINNER)

  durationWeeks        Int?
  classDurationMinutes Int  @default(60)

  status MusicCourseStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches MusicBatch[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
}

model MusicBatch {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  courseId String
  course   MusicCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  teacherUserId String?
  teacher       User?   @relation(fields: [teacherUserId], references: [id], onDelete: SetNull)

  name     String
  capacity Int    @default(20)

  startDate DateTime
  endDate   DateTime?

  days String[]

  startTime String
  endTime   String

  status MusicBatchStatus @default(PLANNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments MusicEnrollment[]

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
}

model MusicEnrollment {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  studentId String
  student   MusicStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  batchId String
  batch   MusicBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())

  feeAmount      Int @default(0)
  discountAmount Int @default(0)

  status MusicEnrollmentStatus @default(ACTIVE)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, batchId])
  @@index([organizationId])
  @@index([organizationId, status])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Shared by every industry that takes attendance (Music batches, Gym
// classes, and whatever comes next) via the same loose context/
// contextId pair Document uses — one check-in record shape instead of
// a per-industry attendance table.
model Attendance {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  context   String
  contextId String

  date DateTime

  status AttendanceStatus @default(PRESENT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, context, contextId, date])
  @@index([organizationId, date])
  @@index([organizationId, context, contextId, date])
}

enum GymMemberStatus {
  ACTIVE
  INACTIVE
  FROZEN
  CANCELLED
}

model GymMember {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  memberNo String
  status   GymMemberStatus @default(ACTIVE)
  joinedAt DateTime        @default(now())
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, memberNo])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
}

enum GymClassStatus {
  ACTIVE
  INACTIVE
}

model GymClass {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  trainerUserId String?
  trainer       User?   @relation(fields: [trainerUserId], references: [id], onDelete: SetNull)

  name     String
  capacity Int    @default(20)

  startDate DateTime
  endDate   DateTime?
  days      String[]
  startTime String
  endTime   String

  status GymClassStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
}

model MusicPracticeLog {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  studentId String
  student   MusicStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  minutes Int

  instrument      String?
  piece           String?
  notes           String?
  teacherFeedback String?

  rating Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, studentId, date])
}

//Contacts
enum ContactType {
  PERSON
  BUSINESS
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Contact {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  type   ContactType
  status ContactStatus @default(ACTIVE)

  firstName   String?
  lastName    String?
  companyName String?

  email String?
  phone String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries               Enquiry[]
  bookings                Booking[]
  invoices                Invoice[]
  musicStudent            MusicStudent?
  gymMember               GymMember?
  attendances             Attendance[]
  membershipSubscriptions MembershipSubscription[]
  sales                   Sale[]

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, status])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Product {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  code        String
  description String?

  type   ProductType
  status ProductStatus

  price    Decimal  @db.Decimal(12, 2)
  currency String   @default("INR")
  taxRate  Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory    InventoryItem[]
  invoiceLines InvoiceLine[]
  saleLines    SaleLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model InventoryItem {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityOnHand   Int @default(0)
  quantityReserved Int @default(0)
  reorderLevel     Int @default(0)

  status InventoryStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, branchId, productId])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, productId])
  @@index([branchId, productId])
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum EnquirySource {
  WEBSITE
  PHONE
  EMAIL
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  OTHER
}

model Enquiry {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  assignedUserId String?
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  source EnquirySource
  status EnquiryStatus @default(NEW)

  subject     String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, contactId])
  @@index([organizationId, status])
  @@index([assignedUserId])
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  scheduledAt DateTime

  status BookingStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, contactId])
  @@index([organizationId, status])
  @@index([scheduledAt])
}

model Invoice {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  invoiceNumber String

  status InvoiceStatus @default(DRAFT)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)

  currency String @default("INR")

  issuedAt DateTime?
  dueDate  DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, contactId])
  @@index([organizationId, status])
}

model InvoiceLine {
  id String @id @db.Char(32)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  referenceId   String?
  paidAt        DateTime      @default(now())

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([invoiceId])
}

// Attaches to any record (Contact, Invoice, MusicStudent, ...) via a
// loose entityType/entityId pair rather than a per-entity FK — the one
// place in the schema where that's the right call, since the whole
// point of a Documents capability is not needing a new relation column
// on every table that might someday hold a file.
model Document {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  uploadedByUserId String?
  uploadedByUser   User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
}

enum MembershipPlanStatus {
  ACTIVE
  INACTIVE
}

// Any recurring or credit-pack entitlement a business sells — a gym
// membership tier, a class pack, a music-lesson subscription. One
// shared shape instead of a per-industry package/subscription table.
model MembershipPlan {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  price    Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  durationDays     Int
  sessionsIncluded Int?

  status MembershipPlanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions MembershipSubscription[]

  @@index([organizationId])
  @@index([organizationId, status])
}

enum MembershipSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

model MembershipSubscription {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  planId String
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status            MembershipSubscriptionStatus @default(ACTIVE)
  sessionsRemaining Int?

  startsAt  DateTime
  expiresAt DateTime
  autoRenew Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, expiresAt])
  @@index([contactId])
  @@index([planId])
}

enum SaleStatus {
  COMPLETED
  REFUNDED
}

// A separate shape from Invoice on purpose: POS is a walk-in, single-
// tender, immediate checkout ticket (contact optional, no due date, no
// payment terms) — the research behind the capability map was explicit
// that this is a genuinely different transaction shape from invoicing,
// not just a shortcut for creating one.
model Sale {
  id String @id @db.Char(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  soldByUserId String?
  soldByUser   User?   @relation(fields: [soldByUserId], references: [id], onDelete: SetNull)

  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod

  createdAt DateTime @default(now())

  lines SaleLine[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model SaleLine {
  id String @id @db.Char(32)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  staffUserId      String?
  staffUser        User?    @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  commissionPct    Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal? @db.Decimal(12, 2)

  @@index([saleId])
  @@index([staffUserId])
}
